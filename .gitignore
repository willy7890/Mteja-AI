cat > .gitignore << 'EOF'
# Virtual environment
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python

# Environment variables
.env
.env.local
*.env

# Database
*.db
*.sqlite3

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Node (frontend)
node_modules/
dist/
build/

# Logs
*.log
EOF