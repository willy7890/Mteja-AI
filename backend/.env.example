# Copy to backend/.env and fill in. Never commit backend/.env.

# ---- Required ----
# Any long random string: openssl rand -hex 32
SECRET_KEY=
# Pick a free local port if 5432 is taken (scripts/whatsapp-dev.sh starts Postgres on it)
DATABASE_URL=postgresql+asyncpg://mteja:mteja@localhost:5440/mteja_ai

# ---- AI ----
# Optional for webhook work; without it the app starts but cannot give real AI replies
OPENAI_API_KEY=

# ---- WhatsApp (Meta Cloud API) ----
# Any word you choose; type the same word into Meta > WhatsApp > Configuration > Verify token
WHATSAPP_VERIFY_TOKEN=
# Meta > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta > App settings > Basic > App secret (used to check webhook signatures)
META_APP_SECRET=
META_GRAPH_API_VERSION=v20.0
# true = log the bot's WhatsApp replies instead of sending them (no Meta credentials needed)
WHATSAPP_DRY_RUN=false

# ---- Local tunnel (scripts/whatsapp-dev.sh) ----
# Your free ngrok static domain, without https:// (dashboard.ngrok.com > Domains)
NGROK_DOMAIN=
